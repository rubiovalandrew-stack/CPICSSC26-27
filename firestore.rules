rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CHANGE THIS to the admin email you create in Firebase Authentication
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'rubiovalandrew@gmail.com';
    }
    match /news/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /images/{id} { allow read: if true; allow write: if isAdmin(); }
    match /messages/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['text','status','date'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }
  }
}
