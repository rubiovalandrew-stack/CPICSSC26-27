rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'rubiovalandrew@gmail.com';
    }
    // Students may only change the like counters, and only by 1 at a time.
    function delta(f) {
      return request.resource.data.get(f, 0) - resource.data.get(f, 0);
    }
    function onlyReacting(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields)
        && (request.resource.data.get('likes', 0) is int
            || request.resource.data.get('likes', 0) is float)
        && (request.resource.data.get('dislikes', 0) is int
            || request.resource.data.get('dislikes', 0) is float)
        && request.resource.data.get('likes', 0) >= 0
        && request.resource.data.get('dislikes', 0) >= 0
        && delta('likes') >= -1 && delta('likes') <= 1
        && delta('dislikes') >= -1 && delta('dislikes') <= 1;
    }

    match /news/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyReacting(['likes','dislikes']);
    }

    match /images/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyReacting(['likes']);
    }

    match /imageSubmissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['src','caption','status','date'])
                    && request.resource.data.src is string
                    && request.resource.data.src.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
                    && request.resource.data.src.size() <= 900000
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 100
                    && request.resource.data.status == 'pending'
                    && request.resource.data.date is int;
      allow read, update, delete: if isAdmin();
    }

    match /siteContent/contact {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/importantAnnouncement {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/newsPopupSettings {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['text','status','date'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 1500;
      allow update: if isAdmin()
                    || (resource.data.status == 'approved' && onlyReacting(['likes','dislikes']));
      allow delete: if isAdmin();
    }

    match /comments/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['messageId','text','status','date'])
                    && request.resource.data.messageId is string
                    && get(/databases/$(database)/documents/messages/$(request.resource.data.messageId)).data.status == 'approved'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 2
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }
  }
}
